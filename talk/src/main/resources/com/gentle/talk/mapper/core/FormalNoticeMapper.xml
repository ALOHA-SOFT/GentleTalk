<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gentle.talk.mapper.core.FormalNoticeMapper">

    <resultMap id="FormalNoticeMap" type="com.gentle.talk.domain.core.FormalNotice">
        <id property="no" column="no"/>
        <result property="id" column="id"/>
        <result property="userNo" column="user_no"/>
        <result property="opponentUserNo" column="opponent_user_no"/>
        <result property="formalNoticeNo" column="formal_notice_no"/>
        <result property="categoryKey" column="category_key"/>
        <result property="categoryData"
                column="category_data"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>

        <result property="senderName" column="sender_name"/>
        <result property="senderPhone" column="sender_phone"/>
        <result property="senderAddress" column="sender_address"/>

        <result property="receiverName" column="receiver_name"/>
        <result property="receiverPhone" column="receiver_phone"/>
        <result property="receiverAddress" column="receiver_address"/>

        <result property="previewText" column="preview_text"/>
        <result property="status" column="status"/>
        <result property="analysisResult" column="analysis_result"/>
        <result property="flag" column="flag"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

        <association property="user" column="user_no" javaType="Users" select="selectUser"/>
        <association property="opponentUser" column="opponent_user_no" javaType="Users" select="selectUser"/>
    </resultMap>

    <!-- 회원 정보 조회 -->
    <select id="selectUser" resultType="Users">
        SELECT *
        FROM users
        WHERE no = #{userNo}
    </select>

    <!-- 내용증명 코드로 조회 -->
    <!-- 주의: formal_notice_code 컬럼이 실제 테이블에 있어야 동작 -->
    <select id="selectByFormalNoticeCode" resultMap="FormalNoticeMap">
        SELECT *
        FROM formal_notice
        WHERE formal_notice_code = #{formalNoticeCode}
    </select>

    <!-- 회원 번호로 내용증명 목록 조회 -->
    <select id="selectByUserNo" resultMap="FormalNoticeMap">
        SELECT *
        FROM formal_notice
        WHERE user_no = #{userNo}
        ORDER BY created_at DESC
    </select>

    <!-- 상대방 회원 번호로 내용증명 목록 조회 -->
    <select id="selectByOpponentUserNo" resultMap="FormalNoticeMap">
        SELECT *
        FROM formal_notice
        WHERE opponent_user_no = #{opponentUserNo}
        ORDER BY created_at DESC
    </select>

    <!-- 페이징 조회 -->
    <select id="listWithParams" resultMap="FormalNoticeMap">
        SELECT f.*
        FROM formal_notice f
        WHERE 1=1
        <if test="userNo != null">
            AND (f.user_no = #{userNo} OR f.opponent_user_no = #{userNo})
        </if>
        <if test="status != null and status != ''">
            AND f.status = #{status}
        </if>
        <if test="search != null and search != ''">
            AND (
                f.sender_name LIKE CONCAT('%', #{search}, '%')
                OR f.receiver_name LIKE CONCAT('%', #{search}, '%')
                OR f.preview_text LIKE CONCAT('%', #{search}, '%')
                OR f.category_key LIKE CONCAT('%', #{search}, '%')
                OR f.id LIKE CONCAT('%', #{search}, '%')
            )
        </if>
        <if test="sortBy != null and sortBy.size() > 0">
            ORDER BY
            <foreach collection="sortBy" item="sortField" index="idx" separator=",">
                ${sortField}
            </foreach>
        </if>
        <if test="sortBy == null or sortBy.size() == 0">
            ORDER BY f.created_at DESC
        </if>
        <if test="limit != null and offset != null">
            LIMIT #{limit} OFFSET #{offset}
        </if>
    </select>

    <!-- 상태별 내용증명 개수 조회 -->
    <select id="countByStatus" resultType="int">
        SELECT COUNT(*)
        FROM formal_notice
        WHERE (user_no = #{userNo} OR opponent_user_no = #{userNo})
        <if test="status != null and status != ''">
            AND status = #{status}
        </if>
    </select>

    <!-- 최근 내용증명 조회 -->
    <select id="selectRecentIssues" resultMap="FormalNoticeMap">
        SELECT *
        FROM formal_notice
        WHERE (user_no = #{userNo} OR opponent_user_no = #{userNo})
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

    <!-- 내용증명 번호로 조회 -->
    <select id="selectByFormalNoticeNo" resultMap="FormalNoticeMap">
        SELECT *
        FROM formal_notice
        WHERE formal_notice_no = #{formalNoticeNo}
    </select>

    <!-- 분석 결과 및 상태 업데이트 -->
    <update id="updateAnalysisResult">
        UPDATE formal_notice
        SET
            analysis_result = #{analysisResult},
            status = #{status},
            updated_at = NOW()
        WHERE no = #{no}
    </update>

    <update id="updateStatusAndFlag">
        UPDATE formal_notice
        SET status = #{status},
            flag = #{flag}
        WHERE no = #{no}
    </update>

</mapper>